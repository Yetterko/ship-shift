{
  "name": "ship-shift",
  "version": "0.1.0",
  "description": "A gamified agentic development environment: run Claude coding agents like a kitchen line.",
  "main": "server/index.mjs",
  "scripts": {
    "start": "node server/index.mjs",
    "sim": "node -e \"process.env.SHIP_SIM='1';import('./server/index.mjs')\"",
    "demo": "node server/index.mjs --demo",
    "example": "node examples/run.mjs",
    "public": "node server/index.mjs --public",
    "share": "node server/share.mjs",
    "reset": "node server/reset.mjs",
    "check": "node server/check.mjs",
    "smoke": "node test/smoke.mjs",
    "mobile": "node test/mobile.mjs",
    "game": "node test/game.mjs",
    "sharetest": "node test/share.mjs",
    "world": "node test/world.mjs",
    "apitest": "node test/api.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.330",
    "@anthropic-ai/sdk": "^1.12.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "three": "^0.187.0",
    "ws": "^8.23.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1"
  }
}
