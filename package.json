{
  "name": "ship-shift",
  "version": "0.2.0",
  "description": "Ship Shift: an Overcooked-style kitchen game that turns AI coding agents into Chefs and Customers.",
  "main": "server/index.mjs",
  "scripts": {
    "start": "node server/index.mjs",
    "showcase": "node -e \"process.env.SHOWCASE='1';import('./server/index.mjs')\"",
    "test:server": "node test/server.mjs",
    "test:agents": "node test/agents.mjs",
    "test:floor": "node test/floor.mjs",
    "test:floor-mobile": "node test/floor-mobile.mjs",
    "test:world": "node test/world.mjs",
    "test:world-mobile": "node test/world-mobile.mjs",
    "test:showcase": "node test/showcase.mjs",
    "test:load": "node test/load.mjs",
    "test": "npm run test:server && npm run test:agents && npm run test:floor && npm run test:floor-mobile && npm run test:world && npm run test:world-mobile && npm run test:showcase && npm run test:load",
    "tv": "node tools/tv-shots.mjs",
    "check": "node server/check.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.330",
    "@anthropic-ai/sdk": "^1.12.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "three": "^0.187.0",
    "ws": "^8.23.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1"
  }
}
